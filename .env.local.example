# =============================================================================
# .env.local.example — Local dev / CI environment reference
#
# Copy to `.env.local` for local development and fill in real values.
# `.env.local` is gitignored — never commit it.
#
# CI (GitHub Actions, .github/workflows/ci.yml) generates its own `.env.local`
# from GitHub Secrets ONLY — no default values (public repo; nothing hardcoded).
# See `docs/testing/strategy.md` → CI Pipeline.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase Web SDK config — REQUIRED, dev server crashes at startup without these
# (src/firebase/firebaseWebConfig.ts → auth/invalid-api-key)
#
# Locally, fill in your target Firebase project's web app values.
# In CI, these come from GitHub Secrets with the same variable names — there are
# NO fallbacks, so every variable below must exist as a repo secret.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=NEXT_PUBLIC_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
NEXT_PUBLIC_FIREBASE_PROJECT_ID=NEXT_PUBLIC_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=NEXT_PUBLIC_FIREBASE_APP_ID

# Web app backend calls — points at the running Next.js server during local dev / CI
NEXT_PUBLIC_FIREBASE_BACKEND_URL=http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Firebase Admin SDK credentials — REQUIRED for server-side API routes
#
# GOOGLE_APPLICATION_CREDENTIALS must be a FILE PATH locally (src/firebase/
# firebaseAdminConfig.ts supports both file paths and inline JSON strings).
# Put the service account key JSON at the path below:
# -----------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=./gcp_credentials.json

# -----------------------------------------------------------------------------
# E2E test accounts (Playwright)
# -----------------------------------------------------------------------------
PW_TEST_EMAIL=pw_test_exam@certestic.com
PW_TEST_PASSWORD=PW_TEST_PASSWORD
PW_SIGNUP_EMAIL=PW_SIGNUP_EMAIL
PW_SIGNUP_PASSWORD=PW_SIGNUP_PASSWORD

# -----------------------------------------------------------------------------
# App config / API endpoints (see .env.sample for the full list)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SERVER_API_URL=NEXT_PUBLIC_SERVER_API_URL
NEXT_PUBLIC_HOST_URL=NEXT_PUBLIC_HOST_URL
NEXT_PUBLIC_GA_TRACKING_ID=NEXT_PUBLIC_GA_TRACKING_ID
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY

# Security secrets (MUST be strong random values — see .env.sample)
# JOSE_JWT_SECRET=...
# SERVICE_SECRET=...
# MARKETING_API_URL=...
# MARKETING_API_JWT_SECRET=...
